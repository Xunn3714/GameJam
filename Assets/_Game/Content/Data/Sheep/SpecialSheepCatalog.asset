      codexDescription: "\u8349\u539F\u4E0A\u6700\u5177\u538B\u8FEB\u611F\u7684\u91CD\u578B\u88C5\u7532\u5C0F\u7F8A\uFF0C\u5149\u662F\u505C\u5728\u90A3\u91CC\u5C31\u8DB3\u4EE5\u628A\u65C1\u8FB9\u7684\u5C0F\u7F8A\u886C\u5F97\u683C\u5916\u6E3A\u5C0F\u3002\u867D\u7136\u884C\u52A8\u4E0D\u7B97\u7075\u6D3B\uFF0C\u4F46\u6B63\u9762\u51B2\u8FC7\u6765\u7684\u65F6\u5019\uFF0C\u51E0\u4E4E\u6CA1\u6709\u8C01\u613F\u610F\u6321\u5728\u5B83\u524D\u9762\u3002\n\n\"\u5927\u5BB6\u7B2C\u4E00\u6B21\u89C1\u5B83\u90FD\u53EA\u987E\u7740\u770B\u90A3\u5C42\u539A\u88C5\u7532\uFF0C\"\u540E\u52E4\u7F8A\u8BF4\uFF0C\"\u53EA\u6709\u6211\u6CE8\u610F\u5230\u5B83\u5F00\u4E86\u534A\u5929\u5C31\u8DB4\u7A9D\u4E86\u2014\u2014\u5B83\u4ECE\u9A7E\u9A76\u8231\u91CC\u63A2\u51FA\u5934\uFF0C\u5F88\u5E73\u9759\u5730\u8BF4\uFF1A'\u8FD9\u4E0D\u662F\u6545\u969C\uFF0C\u662F\u6218\u672F\u6027\u7EF4\u62A4\u3002'\""
      visualEffectDescription: 
      gameplayEffectDescription: 
      unlockHint: 
      spawnEnabled: 1
    - assetGuid: 51946d0d3bcbe944fbee9c49702c4c7c
