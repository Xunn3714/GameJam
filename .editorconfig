root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,shader,hlsl,compute,cginc}]
indent_style = space
indent_size = 4

[*.{json,asmdef,asmref,inputactions}]
indent_style = space
indent_size = 2

[*.{yml,yaml,unity,prefab,asset,meta}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

